{
  "name": "liquplayer",
  "version": "1.0.0",
  "description": "Powerful, modern open-source liquid glass video player with authentic optical refraction, chromatic rim dispersion, universal streaming engine (HLS, DASH, YouTube, Vimeo, Direct MP4/WebM), floating miniplayer, and low-RAM hardware optimization for web, desktop, and mobile.",
  "main": "LiQuPlayer.js",
  "module": "src/LiQuPlayer.js",
  "types": "LiQuPlayer.d.ts",
  "style": "LiQuPlayer.css",
  "files": [
    "LiQuPlayer.js",
    "LiQuPlayer.css",
    "LiQuPlayer.d.ts",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./LiQuPlayer.d.ts",
      "import": "./src/LiQuPlayer.js",
      "require": "./LiQuPlayer.js"
    },
    "./dist/LiQuPlayer.css": "./dist/LiQuPlayer.css",
    "./LiQuPlayer.css": "./LiQuPlayer.css"
  },
  "scripts": {
    "build": "node scripts/bundle.js",
    "start": "npx serve .",
    "test": "node scripts/bundle.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ImAhmedZarir/LiQuPlayer.js.git"
  },
  "keywords": [
    "video-player",
    "liquplayer",
    "liquid-glass",
    "liquid-glass-ui",
    "html5-video",
    "videojs-alternative",
    "hls",
    "hlsjs",
    "mpeg-dash",
    "dashjs",
    "youtube-player",
    "vimeo-player",
    "optical-refraction",
    "chromatic-aberration",
    "glassmorphism",
    "apple-glass",
    "media-player",
    "pip",
    "miniplayer",
    "subtitles",
    "captions",
    "ambient-glow",
    "responsive-video-player"
  ],
  "author": "Ahmed Zarir <im.ahmedzarir@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ImAhmedZarir/LiQuPlayer.js/issues"
  },
  "homepage": "https://github.com/ImAhmedZarir/LiQuPlayer.js#readme"
}
